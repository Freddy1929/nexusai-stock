# Aplicación backend
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:4200
JWT_SECRET=REEMPLAZA_ESTE_SECRETO_LOCAL_POR_UNO_ALEATORIO_DE_32_CARACTERES
JWT_EXPIRES_IN=8h
IVA_PORCENTAJE=15

# Usuario administrador inicial (solo desarrollo local)
ADMIN_EMAIL=admin@nexusai.local
ADMIN_PASSWORD=CambiaEsteEjemploPorUnaClaveFuerte123

# PostgreSQL local (coincide con los valores por defecto de docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusai_stock
DB_USER=nexusai
DB_PASSWORD=nexusai_dev
DB_POOL_MAX=10

# Datos del emisor para el PDF actual y los comprobantes SRI
EMISOR_RAZON_SOCIAL=
EMISOR_RUC=
EMISOR_DIRECCION=
EMISOR_NOMBRE_COMERCIAL=
EMISOR_DIRECCION_MATRIZ=
EMISOR_ESTABLECIMIENTO=001
EMISOR_PUNTO_EMISION=001
SRI_AMBIENTE=1
SRI_CERT_PATH=
SRI_CERT_PASSWORD=

# SMTP para enviar facturas (completar con credenciales propias)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# PgAdmin
PGADMIN_EMAIL=admin@nexusai.local
PGADMIN_PASSWORD=admin_dev
PGADMIN_PORT=5050

# Odoo 18.0 local (genera contraseñas aleatorias y guárdalas solo en .env)
ODOO_PORT=8069
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=REEMPLAZA_POR_UNA_CLAVE_ALEATORIA
ODOO_MASTER_PASSWORD=REEMPLAZA_POR_OTRA_CLAVE_ALEATORIA

# Integración backend-Odoo (se activará en la etapa 2)
ODOO_URL=http://localhost:8069
ODOO_DB=nexusai_odoo
ODOO_USER=
ODOO_API_KEY=
ODOO_COMPANY_ID=1
FACTURACION_PROVIDER=pdf
